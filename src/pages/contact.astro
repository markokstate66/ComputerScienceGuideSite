---
// The form posts JSON to /api/contact (Azure Function in api/contact), which emails the message to
// the site owner through Azure Communication Services. Nothing is stored by the site itself.
// "Report an error" links on articles arrive as /contact/?topic=correction&page=/pillar/slug/.
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout
  title="Contact"
  path="/contact/"
  schemaType="ContactPage"
  searchable={false}
  showUpdated={false}
  description="Report an error in an article, suggest a topic, or ask a question about Computer Science Guide using the contact form. Messages go straight to the author."
  lede="Report an error, suggest a topic or ask a question. Messages are emailed directly to the author."
>
  <form id="contact-form" class="form" novalidate>
    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required autocomplete="name" maxlength="120" />
    </div>
    <div class="field">
      <label for="email">Email address <span class="hint">(used only to reply to you)</span></label>
      <input type="email" id="email" name="email" required autocomplete="email" maxlength="200" />
    </div>
    <div class="field">
      <label for="topic">What is this about?</label>
      <select id="topic" name="topic" required>
        <option value="">Choose one</option>
        <option value="Correction" data-key="correction">An error in an article</option>
        <option value="Content Suggestion" data-key="suggestion">A topic suggestion</option>
        <option value="General Question" data-key="question">A question</option>
        <option value="Bug Report" data-key="bug">A problem with the website</option>
        <option value="Privacy" data-key="privacy">A privacy or data request</option>
        <option value="Other" data-key="other">Something else</option>
      </select>
    </div>
    <div class="field">
      <label for="message">Message <span class="hint" id="message-hint">(for corrections, say which article and what is wrong)</span></label>
      <textarea id="message" name="message" rows="7" required maxlength="5000" aria-describedby="message-hint"></textarea>
    </div>
    <div>
      <button type="submit" class="btn btn-primary" id="submit-btn">Send message</button>
    </div>
    <div id="form-status" class="form-status" role="status" aria-live="polite" hidden></div>
  </form>

  <h2 id="what-happens">What happens to your message</h2>
  <p>The form sends your name, email address, chosen subject and message to a small server function, which emails them to the author through Azure Communication Services. The site has no database and keeps no copy. Details, including how long messages are kept, are in the <a href="/privacy/#contact-form">privacy policy</a>.</p>
  <p>Error reports are checked against the sources. If the report is right, the article is fixed and the change is listed on the <a href="/corrections/">corrections page</a>.</p>

  <h2 id="other-channels">Other ways to reach the author</h2>
  <p>You can also email <a href="mailto:mark@stgengineer.com">mark@stgengineer.com</a> directly, or visit <a href="https://stgengineer.com">stgengineer.com</a>.</p>
</PageLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const status = document.getElementById('form-status') as HTMLElement;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

  // Prefill from "Report an error" links.
  const params = new URLSearchParams(location.search);
  const key = params.get('topic');
  const page = params.get('page');
  if (key) {
    const option = form.querySelector<HTMLOptionElement>(`option[data-key="${CSS.escape(key)}"]`);
    if (option) field('topic').value = option.value;
  }
  if (page && /^\/[a-z0-9\-\/]*$/.test(page)) field('message').value = `Article: ${location.origin}${page}\n\nWhat is wrong:\n`;

  const show = (kind: 'success' | 'error', text: string) => {
    status.className = `form-status ${kind}`;
    status.textContent = text;
    status.hidden = false;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.hidden = true;
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: field('name').value.trim(),
          email: field('email').value.trim(),
          topic: field('topic').value,
          message: field('message').value.trim(),
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) throw new Error(result.message || 'The message could not be sent.');
      show('success', 'Thank you. Your message has been sent.');
      form.reset();
    } catch (err) {
      show('error', `${(err as Error).message} Nothing was sent; please try again in a few minutes.`);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send message';
    }
  });
</script>
