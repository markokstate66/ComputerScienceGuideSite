---
// Served with a real 404 status by Azure Static Web Apps (responseOverrides in
// staticwebapp.config.json). The direct URL /404.html is served with X-Robots-Tag: noindex.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLivePillars } from '../lib/content';
const hasTopics = (await getLivePillars()).length > 0;
---
<BaseLayout title="Page not found" description="The page you asked for does not exist on Computer Science Guide. Use search, the topic list or the glossary to find what you were looking for.">
  <header class="page-head">
    <div class="container narrow">
      <p class="eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p class="lede">There is nothing at this address. The site was reorganised in 2026 and some older guide pages were retired, so an old bookmark or link may have brought you here.</p>
    </div>
  </header>
  <div class="container narrow">
    <div class="prose">
      <form class="search-box" role="search" action="/search/" method="get">
        <label class="visually-hidden" for="q404">Search the site</label>
        <input class="input" type="search" id="q404" name="q" placeholder="Search the site" autocomplete="off" />
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
      <p>Other ways to find it:</p>
      <ul>
        {hasTopics && <li><a href="/topics/">Browse all topics</a></li>}
        <li><a href="/start-here/">Start here</a>, for how the site is organised</li>
        <li><a href="/glossary/">Look up a term in the glossary</a></li>
        <li><a href="/contact/">Tell us about a broken link</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
