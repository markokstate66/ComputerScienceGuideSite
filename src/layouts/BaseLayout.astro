---
import '../styles/global.css';
import NeedsMarkus from '../components/NeedsMarkus.astro';
import { SITE, jsonLd } from '../lib/site';
import { getLivePillars, pillarUrl } from '../lib/content';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of the social image (1200x630 PNG, < 100 KB). */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects for this page (Article, BreadcrumbList, ...). */
  structuredData?: Record<string, unknown>[];
  /** Article pages pass these for og:article tags. */
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { title, description, ogImage = '/og-default.png', ogType = 'website', structuredData = [], publishedTime, modifiedTime } = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? `${SITE.name}: ${title}` : `${title} | ${SITE.name}`;
// Canonical is always the production origin + the trailing-slash path, never the local preview host.
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

const livePillars = await getLivePillars();
const hasTopics = livePillars.length > 0;

const nav = [
  ...(hasTopics ? [{ href: '/topics/', label: 'Topics' }] : []),
  { href: '/start-here/', label: 'Start here' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href === '/topics/' && livePillars.some((p) => path.startsWith(pillarUrl(p.pillar))));

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/logo.png`, width: 512, height: 512 },
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: `${SITE.url}/`,
  description: SITE.description,
  inLanguage: 'en',
  publisher: { '@id': `${SITE.url}/#organization` },
  // /search/ reads the q parameter and runs the query (see src/pages/search.astro).
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/search/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Theme contract: <html data-theme> + localStorage.theme. Runs before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-theme', t);
        d.classList.add('js');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1217" media="(prefers-color-scheme: dark)" />

    <!-- Search engine ownership verification -->
    <meta name="google-site-verification" content="W1fRrbtzjKXN6cAPGyiSBlyKfNfyY23qQgSy-q4-vMg" />
    <meta name="msvalidate.01" content="E4792860CAB72733FACE91C7EE52BB14" />

    <!-- ADSENSE-VERIFICATION-SNIPPET: paste the site-verification snippet from the AdSense "Sites" page on the line below
         when applying (docs/NEEDS_MARKUS.md item 11). This is the only place ad-related code may go. No ad units. -->

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={jsonLd(organization)} />
    <script type="application/ld+json" set:html={jsonLd(website)} />
    {structuredData.map((data) => <script type="application/ld+json" set:html={jsonLd(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">
          <span class="logo-mark" aria-hidden="true">CS</span>
          <span class="logo-text-long">Computer Science Guide</span>
          <span class="logo-text-short" aria-hidden="true">CS Guide</span>
        </a>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="header-tools">
          <a class="icon-btn" href="/search/" aria-label="Search the site">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg>
          </a>
          <button class="icon-btn theme-toggle" type="button" aria-label="Switch between light and dark theme">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4"></path></svg>
          </button>
          <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
            <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-about">
            <a href="/" class="logo">
              <span class="logo-mark" aria-hidden="true">CS</span>
              <span>Computer Science Guide</span>
            </a>
            <p>Computer science fundamentals with C# examples. Every program on this site is compiled and run, and its output checked, before the article is published.</p>
          </div>
          {hasTopics && (
            <nav aria-label="Topics">
              <h2 class="footer-heading">Topics</h2>
              <ul>
                {livePillars.map(({ pillar }) => <li><a href={pillarUrl(pillar)}>{pillar.data.navTitle}</a></li>)}
              </ul>
            </nav>
          )}
          <nav aria-label="Learn">
            <h2 class="footer-heading">Learn</h2>
            <ul>
              <li><a href="/start-here/">Start here</a></li>
              {hasTopics && <li><a href="/topics/">All topics</a></li>}
              <li><a href="/glossary/">Glossary</a></li>
              <li><a href="/search/">Search</a></li>
            </ul>
          </nav>
          <nav aria-label="About this site">
            <h2 class="footer-heading">About</h2>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/editorial-policy/">Editorial policy</a></li>
              <li><a href="/corrections/">Corrections</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy policy</a></li>
              <li><a href="/terms/">Terms of use</a></li>
            </ul>
          </nav>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="container">
          <p>&copy; {new Date().getUTCFullYear()} <NeedsMarkus n={4} what="legal or business name" /></p>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
